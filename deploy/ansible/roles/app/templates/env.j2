DEBUG={{ django_debug }}
SECRET_KEY={{ django_secret_key }}
DJANGO_ALLOWED_HOSTS={{ app_domains | join(' ') }}
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE={{ db_name }}
SQL_USER={{ db_user }}
SQL_PASSWORD={{ db_password }}
SQL_HOST={{ db_host }}
SQL_PORT={{ db_port }}

# Postgres container uses these directly
POSTGRES_DB={{ db_name }}
POSTGRES_USER={{ db_user }}
POSTGRES_PASSWORD={{ db_password }}
GEOPOSITION_GOOGLE_MAPS_API_KEY={{ geoposition_google_maps_api_key | default('') }}
MAILGUN_API_KEY={{ mailgun_api_key | default('') }}
MAILGUN_SENDER_DOMAIN={{ mailgun_sender_domain | default('') }}
DEFAULT_FROM_EMAIL={{ default_from_email }}
GUNICORN_REWRITE_HTTPS=1
SAVE_RESULT_UPLOADS=True
SAVE_RESULT_UPLOADS_DIR=/app/media
STATIC_ROOT=/var/lib/cabici/staticfiles
MEDIA_ROOT=/app/media
